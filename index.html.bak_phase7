<body class="bg-surface-container-lowest text-on-surface font-body-md text-body-md min-h-screen selection:bg-primary-container selection:text-on-primary-container">

<header class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_4px_24px_rgba(0,0,0,0.6)]">
  <div class="hidden lg:block bg-surface-container-low px-gutter-lg">
    <div class="w-full flex items-center justify-between h-7">
      <div class="flex items-center gap-space-lg">
        <div class="flex items-center gap-space-xs">
          <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
          <span class="font-label-hud text-label-hud text-primary uppercase">ROCKPORT EN VIVO</span>
          <span class="font-label-data text-label-data text-on-surface-variant">// TKR: 128Hz</span>
          <span class="font-label-data text-label-data text-tertiary">RTT: 12ms</span>
        </div>
        <div class="flex items-center gap-space-xs">
          <span class="font-label-hud text-label-hud text-outline">HEAT LEVEL POLICE RADAR:</span>
          <span class="font-label-data text-label-data text-secondary">CONDICION 5 - STATE PATROL POLICE RADIO ACTIVE</span>
        </div>
      </div>
      <div class="flex items-center gap-space-md">
        <span class="font-label-hud text-label-hud text-outline">GLOBAL V5.12 SPEEDRUN PROTOCOL</span>
        <span class="font-label-data text-label-data text-primary-container">SYNC OK</span>
      </div>
    </div>
  </div>

  <div class="h-20 w-full px-gutter-lg flex items-center justify-between gap-space-md">
    <div class="flex-1 basis-0 min-w-0 flex items-center justify-start gap-space-lg">
      <a class="flex items-center gap-space-sm group cursor-pointer shrink-0" href="#home" data-action="navigate" data-target="home" title="Need for Speed: Most Wanted Ranks (NFSMWRANKS.ONLINE)">
        <img alt="NFS Logo" class="h-9 w-auto object-contain transition-transform group-hover:scale-105 drop-shadow-[0_2px_8px_rgba(226,38,60,0.45)]" src="assets/img/logo-badge.svg"/>
        <div class="flex flex-col">
          <span class="font-headline-sm text-[20px] md:text-headline-sm text-on-surface font-black uppercase tracking-tight group-hover:text-primary transition-colors leading-none">NFSMWRANKS<span class="text-primary-container">.ONLINE</span></span>
          <span class="font-label-hud text-label-hud text-outline uppercase tracking-wider text-[9px] mt-0.5">BLACK EDITION TELEMETRY</span>
        </div>
      </a>
      <div class="hidden xl:flex items-center relative">
        <div class="relative flex items-center">
          <span class="material-symbols-outlined text-outline absolute left-3 pointer-events-none text-[18px]">search</span>
          <input id="global-search-input" class="bg-surface-container pl-9 pr-14 py-2 w-72 text-on-surface placeholder:text-outline-variant font-label-data text-label-data focus:outline-none focus:bg-surface-container-high transition-all" placeholder="Buscar piloto, circuito, clase de coche..." type="text"/>
          <kbd class="absolute right-2 px-1.5 py-0.5 bg-surface-container-highest text-outline font-label-data text-label-data">Ctrl+K</kbd>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar (100% Pure Stitch Classes & Structure - Estrictamente Centrado) -->
    <nav id="main-nav" class="hidden 2xl:flex items-center justify-center gap-space-xs shrink-0 mx-auto" data-active-classes="text-on-primary-container bg-primary-container font-headline-sm text-label-hud font-bold">
      <a id="nav-home" aria-current="page" class="px-3 py-2 font-headline-sm text-label-hud tracking-widest uppercase transition-colors text-on-primary-container bg-primary-container font-bold cursor-pointer" data-path="home" data-action="navigate" data-target="home" href="#home">HOME</a>
      
      <a id="nav-leaderboard" class="hidden px-3 py-2 font-headline-sm text-label-hud tracking-widest uppercase transition-colors text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high cursor-pointer" data-path="tablas-de-clasificacion" data-action="navigate" data-target="leaderboard" href="#leaderboard">TABLAS DE CLASIFICACIÓN</a>
      
