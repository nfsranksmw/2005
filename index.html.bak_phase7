<div class="flex flex-wrap items-center gap-space-md">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-primary-container animate-ping"></span>
<span class="font-label-hud text-label-hud text-on-surface uppercase">ROCKPORT MESH KERNEL</span>
</div>
<span class="font-label-data text-label-data text-outline">// SUB-FRAME ACCURACY: 0.001s</span>
<span class="font-label-data text-label-data text-tertiary">// PROTOCOLO: MW-AC SHIELD v2.4</span>
</div>
<div class="flex items-center gap-space-md">
<span class="font-label-data text-label-data text-outline">ESTADO DE RADARES URBANOS:</span>
