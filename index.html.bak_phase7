<!-- Junkman Category -->
<div class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-primary-container text-[20px] mt-0.5 shrink-0">settings_suggest</span>
<div class="flex flex-col">
<div class="flex items-center gap-space-xs">
<span class="font-headline-sm text-body-md text-on-surface uppercase font-bold">Categoría Junkman (Open Max)</span>
<span class="font-label-data text-label-data text-primary-container bg-surface-container px-1 rounded">SIN LÍMITE</span>
</div>
