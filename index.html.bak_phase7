</header>

<main class="w-full pt-20 bg-surface-container-lowest min-h-screen">

<!-- VIEW SECTION: view-home -->
<section id="view-home" class="view-section active">
<div class="flex flex-col w-full">
<!-- HERO SECTION WITH CINEMATIC DRIFT BACKDROP -->
<section class="relative w-full overflow-hidden bg-surface-container-lowest py-space-xl lg:py-28" style="background-image: linear-gradient(180deg, rgba(11, 14, 21, 0.85) 0%, rgba(11, 14, 21, 0.50) 40%, rgba(11, 14, 21, 0.95) 100%), url('assets/img/hero-bmw-m3-gtr-banner.jpg'); background-size: cover; background-position: center 30%; background-repeat: no-repeat;">
<!-- Atmospheric Underglows & Grid Overlay -->
<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-secondary-container/15 blur-[140px] pointer-events-none rounded-full"></div>
<div class="absolute top-1/4 -right-24 w-[500px] h-[350px] bg-primary-container/10 blur-[120px] pointer-events-none rounded-full"></div>
<div class="absolute inset-0 bg-[radial-gradient(#272a31_1px,transparent_1px)] [background-size:24px_24px] opacity-20 pointer-events-none"></div>
<div class="relative max-w-7xl mx-auto px-gutter lg:px-gutter-lg flex flex-col items-center text-center">
<!-- Seasonal Protocol Badge -->
<div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container text-outline border-none shadow-md mb-space-lg">
<span class="w-2 h-2 rounded-full bg-secondary-container animate-ping"></span>
<span class="font-label-hud text-label-hud text-secondary uppercase tracking-widest">TEMPORADA 2026</span>
<span class="text-outline-variant font-label-data text-label-data">//</span>
<span class="font-label-hud text-label-hud text-on-surface uppercase tracking-wider">RETO BLACKLIST 15 CLASIFICATORIA</span>
</div>
<!-- Main Headline with Industrial Gold Flare -->
<h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface uppercase tracking-tighter max-w-5xl leading-none">
<span class="text-transparent bg-clip-text bg-gradient-to-r from-secondary-container via-primary-container to-primary">RÉCORDS MUNDIALES</span>
<br class="hidden sm:inline"/>
<span class="text-on-surface">DE ROCKPORT</span>
</h1>
<p class="font-body-lg text-body-md md:text-body-lg text-outline max-w-2xl mt-space-md mb-space-xl">
        La red definitiva de telemetría de precisión, tiempos de vuelta auditados milimétricamente a 128Hz y arbitraje anti-trampas de <span class="text-on-surface font-semibold">Need for Speed: Most Wanted (2005)</span>.
      </p>
<!-- HUD Command Search Bar -->
<div class="w-full max-w-2xl bg-surface-container-high/90 shadow-2xl p-1.5 flex items-center gap-2 backdrop-blur-md mb-space-xl">
<div class="flex items-center pl-3 text-outline">
<span class="material-symbols-outlined text-[20px]">search</span>
</div>
<input class="w-full bg-transparent text-on-surface font-label-data text-body-md placeholder:text-outline/70 focus:outline-none py-2" placeholder="Buscar piloto, circuito, récord oficial o rival Blacklist..." type="text"/>
<div class="hidden sm:flex items-center px-2 py-1 bg-surface-container-highest text-outline font-label-data text-label-data">
          Ctrl+K
        </div>
<button class="bg-gradient-to-r from-secondary-container to-primary-container hover:brightness-110 active:scale-95 text-on-secondary-container px-6 py-2.5 font-headline-sm text-body-sm uppercase font-extrabold flex items-center gap-1.5 transition-all shadow-lg shadow-secondary-container/20 shrink-0">
<span>CONSULTAR</span>
<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
</button>
</div>
<!-- Real-Time Telemetry Counters Strip -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-space-sm w-full max-w-3xl mb-space-xl">
<div class="bg-surface-container/70 p-space-md flex flex-col items-center">
<span class="font-label-timer-lg text-label-timer-lg text-primary leading-none">108</span>
<span class="font-label-hud text-label-hud text-outline uppercase tracking-wider mt-1">PILOTOS ACTIVOS</span>
</div>
<div class="bg-surface-container/70 p-space-md flex flex-col items-center">
<span class="font-label-timer-lg text-label-timer-lg text-on-surface leading-none">86</span>
<span class="font-label-hud text-label-hud text-outline uppercase tracking-wider mt-1">RUTAS &amp; CIRCUITOS</span>
</div>
<div class="bg-surface-container/70 p-space-md flex flex-col items-center">
<span class="font-label-timer-lg text-label-timer-lg text-secondary leading-none">15</span>
