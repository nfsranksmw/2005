          <a href="#weekly-challenges" data-action="navigate" data-target="challenges" id="nav-challenges" class="px-3 py-2 font-headline-sm text-body-sm text-on-surface-variant hover:text-primary hover:bg-surface-container-highest uppercase flex items-center gap-2 transition-colors">
