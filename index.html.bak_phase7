<script>
  // Tactical District & Mode Buttons micro-interaction
  document.querySelectorAll('.district-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.district-btn').forEach(b => {
        b.classList.remove('bg-primary-container', 'text-on-primary-container');
        b.classList.add('bg-surface-container', 'text-outline');
      });
      btn.classList.add('bg-primary-container', 'text-on-primary-container');
      btn.classList.remove('bg-surface-container', 'text-outline');
    });
  });

  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mode-btn').forEach(b => {
        b.classList.remove('bg-surface-variant', 'text-primary', 'font-bold');
        b.classList.add('bg-surface-container', 'text-outline');
      });
      btn.classList.add('bg-surface-variant', 'text-primary', 'font-bold');
      btn.classList.remove('bg-surface-container', 'text-outline');
    });
  });

  document.querySelectorAll('.heat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.heat-btn').forEach(b => {
        b.classList.remove('bg-secondary-container', 'text-on-secondary-container');
        b.classList.add('text-outline');
      });
      btn.classList.add('bg-secondary-container', 'text-on-secondary-container');
      btn.classList.remove('text-outline');
    });
  });

  // Highlight route simulation
  document.querySelectorAll('.route-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.route-card').forEach(c => {
        c.classList.remove('bg-surface-container-highest', 'shadow-sm');
        c.classList.add('bg-surface-container');
        const indicator = c.querySelector('.w-1');
        if (indicator) indicator.remove();
      });
      card.classList.add('bg-surface-container-highest', 'shadow-sm');
      card.classList.remove('bg-surface-container');
      
      const line = document.createElement('div');
      line.className = 'absolute left-0 top-0 bottom-0 w-1 bg-primary-container';
      card.prepend(line);
    });
  });
</script>
</section>

