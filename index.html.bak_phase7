            <span>Driver Dossiers (1 - 15)</span>
          </a>
          <a href="#tournament-registration" data-action="navigate" data-target="championship-register" id="nav-championship-register" class="px-3 py-2 font-headline-sm text-body-sm text-on-surface-variant hover:text-primary hover:bg-surface-container-highest uppercase flex items-center gap-2 transition-colors">
            <span class="material-symbols-outlined text-[18px] text-primary-container">how_to_reg</span>
            <span>Tournament Registration</span>
          </a>
          <a href="#tournament-tutorial" data-action="navigate" data-target="tutorial" id="nav-tutorial" class="px-3 py-2 font-headline-sm text-body-sm text-on-surface-variant hover:text-primary hover:bg-surface-container-highest uppercase flex items-center gap-2 transition-colors">
            <span class="material-symbols-outlined text-[18px] text-primary-container">menu_book</span>
            <span>Tournament Tutorial</span>
          </a>
          <a href="#past-tournaments" data-action="navigate" data-target="past-tournaments" id="nav-past-tournaments" class="px-3 py-2 font-headline-sm text-body-sm text-on-surface-variant hover:text-primary hover:bg-surface-container-highest uppercase flex items-center gap-2 transition-colors">
            <span class="material-symbols-outlined text-[18px] text-primary-container">history</span>
