<!-- Micro-Interactions Client Script -->
<script>
    function triggerSearchFeedback() {
      const input = document.getElementById('pilotSearchInput');
      const val = input.value.trim();
      if(!val) {
        input.focus();
        return;
      }
      
      const container = document.getElementById('activeDossierContainer');
      container.classList.add('opacity-40');
      setTimeout(() => {
        container.classList.remove('opacity-40');
      }, 200);
    }

    function setPilot(pilotName) {
      const input = document.getElementById('pilotSearchInput');
      input.value = pilotName;
      triggerSearchFeedback();
    }
  </script>
</div>
