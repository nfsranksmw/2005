<section class="bg-surface-container-low rounded-lg p-space-lg shadow-md flex flex-col justify-between">
<div>
<!-- Card Header -->
<div class="flex items-center justify-between pb-space-sm mb-space-md bg-surface-container-lowest/40 -mx-space-lg -mt-space-lg p-space-md rounded-t-lg">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[24px]">troubleshoot</span>
<h2 class="font-headline-md text-headline-md text-on-surface uppercase tracking-tight">4. TIMING &amp; TIMEBUG DETECTION</h2>
</div>
<span class="font-label-hud text-label-hud px-2 py-0.5 rounded bg-primary/20 text-primary uppercase font-bold">
              SUB-FRAME TELEMETRY
            </span>
</div>
<div class="space-y-space-md">
<!-- External Stopwatch -->
<div class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-primary-container text-[20px] mt-0.5 shrink-0">av_timer</span>
<div class="flex flex-col">
<div class="flex items-center gap-space-xs">
<span class="font-headline-sm text-body-md text-on-surface uppercase font-bold">Cronometraje Forense (Avidemux)</span>
<span class="font-label-data text-label-data text-tertiary bg-surface-container px-1 rounded">FRAME-BY-FRAME</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                  La verificación de precisión absoluta se ejecuta fotograma a fotograma utilizando software certificado <code class="text-on-surface font-label-data text-label-data">Avidemux.exe</code> con formato de milisegundo <span class="font-label-data text-primary">00:00.000</span>.
                </p>
</div>
</div>
<!-- Timebug Threshold -->
<div class="bg-surface-container p-space-sm rounded">
<div class="flex items-center justify-between mb-1">
<span class="font-label-hud text-label-hud text-secondary-container uppercase flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">warning</span>
                  UMBRAL CRÍTICO DE TIMEBUG
                </span>
<span class="font-label-data text-label-data text-outline">DESVIACIÓN &gt; 2 FPS</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                Un <strong class="text-secondary-container">Timebug</strong> se declara oficialmente cuando la discrepancia entre el reloj interno del juego y el recuento real de cuadros excede los <strong class="text-on-surface">2 FPS (6 centésimas de segundo)</strong>. En tal caso, el tiempo del vídeo manda.
              </p>
</div>
<!-- Tie Resolution -->
<div class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-tertiary text-[20px] mt-0.5 shrink-0">balance</span>
<div class="flex flex-col">
<span class="font-headline-sm text-body-md text-on-surface uppercase font-bold">Resolución de Empates al Cuadro</span>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                  En márgenes inferiores a 10 centésimas (0.10s), los árbitros calcularán el instante de contacto de la trompa del coche con la línea de meta para dirimir la posición sin empates ficticios.
                </p>
</div>
</div>
<!-- Anti-Cheat Policy -->
<div class="flex items-start gap-space-sm">
<span class="material-symbols-outlined text-error text-[20px] mt-0.5 shrink-0">security</span>
<div class="flex flex-col">
<span class="font-headline-sm text-body-md text-on-surface uppercase font-bold">Política Anti-Cheat Permanente</span>
<p class="font-body-sm text-body-sm text-on-surface-variant">
