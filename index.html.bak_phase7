<script>
  // Simple micro-interaction for density toggle
  const btnComfortable = document.getElementById('viewComfortable');
  const btnCompact = document.getElementById('viewCompact');
  const tableRows = document.querySelectorAll('tbody tr');
  const tableCells = document.querySelectorAll('tbody td');

  if (btnComfortable && btnCompact) {
    btnCompact.addEventListener('click', () => {
      btnCompact.classList.add('bg-surface-container', 'text-primary-container');
      btnCompact.classList.remove('text-outline');
      btnComfortable.classList.remove('bg-surface-container', 'text-primary-container');
      btnComfortable.classList.add('text-outline');

      tableCells.forEach(cell => {
        cell.classList.remove('py-space-md');
        cell.classList.add('py-2');
      });
    });

    btnComfortable.addEventListener('click', () => {
      btnComfortable.classList.add('bg-surface-container', 'text-primary-container');
      btnComfortable.classList.remove('text-outline');
      btnCompact.classList.remove('bg-surface-container', 'text-primary-container');
      btnCompact.classList.add('text-outline');

      tableCells.forEach(cell => {
        cell.classList.remove('py-2');
        cell.classList.add('py-space-md');
      });
    });
  }
</script>
</section>

