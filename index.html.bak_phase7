<!-- Interactive Filter Switcher Micro-script -->
<script>
    (function() {
      const eraButtons = document.querySelectorAll('#era-filter-group button');
      eraButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          eraButtons.forEach(b => {
            b.className = 'px-3 py-1.5 font-label-hud text-label-hud uppercase tracking-wider text-outline hover:text-on-surface hover:bg-surface-container-high transition-colors';
          });
          btn.className = 'px-3 py-1.5 font-label-hud text-label-hud uppercase tracking-wider bg-primary-container text-on-primary-container transition-colors';
        });
      });
    })();
  </script>
</div>
</section>

