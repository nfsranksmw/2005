<!-- Inline Micro-Interactions Script -->
<script>
    function setPlayMode(mode) {
      const btnOnline = document.getElementById('btn-mode-online');
      const btnOffline = document.getElementById('btn-mode-offline');
      if (mode === 'online') {
        btnOnline.className = 'flex items-center justify-center gap-1.5 px-2 py-1 rounded-sm font-label-hud text-label-hud uppercase transition-all bg-secondary-container text-on-secondary-container shadow-sm font-bold';
        btnOffline.className = 'flex items-center justify-center gap-1.5 px-2 py-1 rounded-sm font-label-hud text-label-hud uppercase transition-all text-outline hover:text-on-surface';
      } else {
        btnOffline.className = 'flex items-center justify-center gap-1.5 px-2 py-1 rounded-sm font-label-hud text-label-hud uppercase transition-all bg-primary-container text-on-primary-container shadow-sm font-bold';
        btnOnline.className = 'flex items-center justify-center gap-1.5 px-2 py-1 rounded-sm font-label-hud text-label-hud uppercase transition-all text-outline hover:text-on-surface';
      }
    }

    function setCar(carName) {
      const carInput = document.getElementById('vehicle-input');
      if (carInput) {
        carInput.value = carName;
      }
    }

    function triggerValidationAnimation() {
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const successBanner = document.getElementById('success-banner');

      // Visual feedback state
      btnText.innerText = 'AUDITANDO TELEMETRÍA Y FIRMA...';
      submitBtn.classList.add('opacity-75', 'cursor-wait');

      setTimeout(() => {
        btnText.innerText = 'REGISTRO ENVIADO CON ÉXITO';
        submitBtn.classList.remove('opacity-75', 'cursor-wait');
        submitBtn.classList.add('bg-tertiary', 'text-on-tertiary-container');
        if (successBanner) {
          successBanner.classList.remove('hidden');
          successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }, 1200);
    }
  </script>
</div>
